{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "WriteAssist: PreToolUse em-dash prevention (Write|Edit|MultiEdit) + catch-all scanner (Bash/Stop) + tracker + statusline. SessionStart/PreCompact/UserPromptSubmit state + constraint hooks. permissions.allow pre-authorizes the framework's own skill scripts and workflows.",
  "permissions": {
    "allow": [
      "Bash(python3 .claude/skills/canon-lookup/canon.py:*)",
      "Bash(python3 .claude/skills/manuscript-compile/compile.py:*)",
      "Bash(python3 .claude/skills/prose-metrics/metrics.py:*)",
      "Bash(python3 .claude/skills/voice-create/extract-voice-evidence.py:*)",
      "Bash(python3 .claude/skills/voice-update/gather_voice_evidence.py:*)",
      "Bash(python3 .claude/skills/wrp-conformance/conformance.py:*)",
      "Bash(node .claude/workflows/auto-revise-chapter.js:*)",
      "Bash(node .claude/workflows/batch-execute-wrp.js:*)",
      "Bash(node .claude/workflows/compare-drafts.js:*)",
      "Bash(node .claude/workflows/review-chapter.js:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "${CLAUDE_PROJECT_DIR}/.claude/scripts/statusline.sh"
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [
        { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/scripts/state-restore.sh" }
      ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/scripts/constraint-reminder.sh" }
      ] }
    ],
    "PreCompact": [
      { "hooks": [
        { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/scripts/state-snapshot.sh" }
      ] }
    ],
    "PreToolUse": [
      { "matcher": "Write|Edit|MultiEdit",
        "hooks": [ { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/scripts/em-dash-guard.sh" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/scripts/em-dash-scan.sh" } ] },
      { "matcher": "Write|Edit",
        "hooks": [ { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/scripts/post-chapter-review.sh" } ] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/scripts/em-dash-scan.sh" },
        { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/scripts/update-tracker.sh" },
        { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/scripts/state-snapshot.sh" }
      ] }
    ]
  }
}
